def runTimestamp = new Date().format('yyyyMMdd-HHmmss')

manifest {
    name = 'bhklab/fused-embedding-pipeline'
    mainScript = 'main.nf'
    nextflowVersion = '>=25.10.0'
}

params {
    help = false
    downloads = "${projectDir}/config/downloads.yaml"
    embeddings = "${projectDir}/config/embeddings.yaml"
    raw_data = null
    viability = null
    outdir = "${projectDir}/data/results/nextflow"
}

workDir = "${projectDir}/data/work"

process.executor = 'local'
env.PYTHONDONTWRITEBYTECODE = '1'
// The two preparation tasks can run together; training waits for both.
executor.queueSize = 2

trace {
    enabled = true
    file = "${params.outdir}/trace-${runTimestamp}.tsv"
}
report {
    enabled = true
    file = "${params.outdir}/report-${runTimestamp}.html"
}
timeline {
    enabled = true
    file = "${params.outdir}/timeline-${runTimestamp}.html"
}
