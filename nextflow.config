def runTimestamp = new Date().format('yyyyMMdd-HHmmss')

manifest {
    name = 'bhklab/fused-embedding-pipeline'
    mainScript = 'main.nf'
    nextflowVersion = '>=25.10.0'
}

params {
    help = false
    downloads = "${projectDir}/config/downloads.yaml"
    embeddings = "${projectDir}/config/embeddings.yaml"
    raw_data = null
    viability = null
    outdir = "${projectDir}/data/results/nextflow"
    container_image = 'fused-embedding:2026-09-25'
}

profiles {
    standard {
        workDir = "${projectDir}/data/work"
        process.executor = 'local'
    }
    docker {
        workDir = "${projectDir}/data/work"
        process.executor = 'local'
        docker.enabled = true
        process.container = params.container_image
    }
    dnanexus {
        // DNAnexus supplies the executor and cloud work directory.
        docker.enabled = true
        params.container_image = null
        process {
            container = params.container_image
            disk = '40 GB'
            errorStrategy = 'finish'
            withName: 'PREPARE_VIABILITY|GENERATE_EMBEDDINGS' {
                memory = '16 GB'
            }
        }
        params.outdir = 'results'
    }
}
env.PYTHONDONTWRITEBYTECODE = '1'
// The two preparation tasks can run together; training waits for both.
executor.queueSize = 2

trace {
    enabled = true
    file = "${params.outdir}/trace-${runTimestamp}.tsv"
}
report {
    enabled = true
    file = "${params.outdir}/report-${runTimestamp}.html"
}
timeline {
    enabled = true
    file = "${params.outdir}/timeline-${runTimestamp}.html"
}
